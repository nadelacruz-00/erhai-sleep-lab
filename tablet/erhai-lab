JOURNAL = STATE_DIR / "journal.jsonl"


class StepFailed(Exception):
    pass


def read(path: Path, default: str = "") -> str:
    try:
        return path.read_text().strip()
    except OSError:
        return default


def run(cmd: list[str], timeout: float) -> str:
    try:
        return subprocess.run(cmd, check=True, text=True, capture_output=True,
                              timeout=timeout).stdout
    except subprocess.TimeoutExpired:
        raise StepFailed(f"{cmd[0]} timed out after {timeout:.0f} s") from None
    except subprocess.CalledProcessError as e:
        raise StepFailed(f"{' '.join(cmd)} exited {e.returncode}: "
                         f"{(e.stderr or '').strip()[:200]}") from None


def sysfs_write(path: Path, value: str, timeout: float) -> None:
    """Write from a child process: a hung sysfs write cannot hang the hook."""
    run(["sh", "-c", 'printf %s "$1" > "$2"', "sh", value, str(path)], timeout)


def wait_until(pred, budget: float, what: str, interval: float = 0.5) -> None:
    deadline = time.monotonic() + budget
    while True:
        if pred():
            return
        if time.monotonic() >= deadline:
            raise StepFailed(f"{what} not reached within {budget:.0f} s")
        time.sleep(interval)


def session_user() -> tuple[str, int] | None:
    """(name, uid) of the active graphical session of a real user."""
    try:
        out = subprocess.run(["loginctl", "list-sessions", "--no-legend"],
                             text=True, capture_output=True, timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    for line in out.splitlines():
        sid = line.split()[0] if line.split() else ""
        if not sid:
            continue
        props = subprocess.run(["loginctl", "show-session", sid, "-p", "Active",
                                "-p", "Type", "-p", "Name", "-p", "User"],
                               text=True, capture_output=True, timeout=5).stdout
        kv = dict(l.split("=", 1) for l in props.splitlines() if "=" in l)
        if kv.get("Active") == "yes" and kv.get("Type") in ("wayland", "x11") \
                and kv.get("User", "").isdigit() and int(kv["User"]) >= 1000:
            return kv["Name"], int(kv["User"])
    return None


def screensaver_active(active: bool, timeout: float = 10) -> None:
    """gnome-shell ScreenSaver.SetActive: the real DPU/DSI teardown (D13)."""
    who = session_user()
    if who is None:
        raise StepFailed("no active graphical session for SetActive")
    name, uid = who
    rt = f"/run/user/{uid}"
    run(["runuser", "-u", name, "--", "env", f"XDG_RUNTIME_DIR={rt}",
         f"DBUS_SESSION_BUS_ADDRESS=unix:path={rt}/bus", "gdbus", "call",
         "--session", "--dest", "org.gnome.Shell", "--object-path",
         "/org/gnome/ScreenSaver", "--method", "org.gnome.ScreenSaver.SetActive",
         "true" if active else "false"], timeout)


def wlan_state() -> str:
    out = run(["nmcli", "-t", "-f", "DEVICE,STATE", "dev"], 5)
    for line in out.splitlines():
        dev, _, state = line.partition(":")
        if dev.startswith("wlp"):
            return state
    return "(no device)"


def irq_counts(names: tuple[str, ...]) -> dict[str, int]:
    """Total count per named IRQ; IRQ numbers change every boot."""
    counts: dict[str, int] = {}
    try:
        lines = Path("/proc/interrupts").read_text().splitlines()
    except OSError:
        return counts
    ncpu = len(lines[0].split()) if lines else 0
    for line in lines[1:]:
        parts = line.split()
        if parts and parts[-1] in names:
            counts[parts[-1]] = sum(int(x) for x in parts[1:1 + ncpu] if x.isdigit())
    return counts


def wakeup_snapshot() -> dict[str, list[int]]:
    snap: dict[str, list[int]] = {}
    for d in sorted(Path("/sys/class/wakeup").glob("wakeup*")):
        name = read(d / "name")
        try:
            snap[name] = [int(read(d / "event_count", "0")),
                          int(read(d / "wakeup_count", "0"))]
        except ValueError:
            continue
    return snap


def wakeup_diff(before: dict, after: dict) -> dict[str, list[int]]:
    diff = {}
    for name, (ev, wk) in after.items():
        b = before.get(name, [0, 0])
        if ev != b[0] or wk != b[1]:
            diff[name] = [ev - b[0], wk - b[1]]
    return diff


def panel_state() -> dict[str, str]:
    st = {"backlight": read(BACKLIGHT / "actual_brightness")}
    for c in sorted(DRM.glob("card*-DSI-*")):
        st[c.name] = f"{read(c / 'enabled')}/{read(c / 'dpms')}"
    return st


def suspend_stats() -> dict[str, str]:
    d = POWER / "suspend_stats"
    return {p.name: read(p) for p in sorted(d.iterdir())} if d.is_dir() else {}


def qcom_stats() -> dict[str, str]:
    if not QCOM_STATS.is_dir():
        return {"absent": "debugfs qcom_stats not available"}
    return {p.name: read(p)[:400] for p in sorted(QCOM_STATS.iterdir()) if p.is_file()}


class HookActions:
    """The system effect of each plan step and undo action.

    Separate from the plan so the guard and undo logic can be tested with a
    fake (tests/test_hook_guard.py) and the real effects in the on-tablet dry
    run.
    """

    def __init__(self, attempt: Attempt, saved: dict):
        self.a = attempt
        self.saved = saved

    def do(self, name: str, budget: float) -> None:
        getattr(self, name.replace("-", "_"))(budget)

    # display
    def display_off(self, budget):
        run([DISPLAY_TOGGLE, "off"], budget)

    def display_on(self, budget):
        run([DISPLAY_TOGGLE, "on"], budget)

    def display_park(self, budget):
        # The dev's survivable order: GPU parked first, then the real blank
        # (erhai-panel-power.sh). Unlike that script, a GPU that does not
        # park aborts the attempt instead of carrying on (D13).
        self.saved["gpu_control"] = read(GPU_POWER / "control", "on")
        sysfs_write(GPU_POWER / "control", "auto", 5)
        wait_until(lambda: read(GPU_POWER / "runtime_status") == "suspended",
                   budget, "GPU runtime park")
        screensaver_active(True)
        time.sleep(2)
        run([DISPLAY_TOGGLE, "off"], 10)

    def display_unpark(self, budget):
        screensaver_active(False)
        time.sleep(3)
        run([DISPLAY_TOGGLE, "on"], 10)
        sysfs_write(GPU_POWER / "control", self.saved.get("gpu_control", "on"), 5)

    # power-button watcher: its fd must be closed so the wake press is not
    # replayed as a new toggle after resume (harness STEP2b)
    def watcher_stop(self, budget):
        active = subprocess.run(["systemctl", "is-active", "--quiet", WATCHER_UNIT]).returncode == 0
        self.saved["watcher_active"] = active
        if active:
            run(["systemctl", "stop", WATCHER_UNIT], budget)

    def watcher_start(self, budget):
        if self.saved.get("watcher_active"):
            run(["systemctl", "start", WATCHER_UNIT], budget)

    # WCN psoc idle-shutdown timer (harness STEP2d)
    def psoc_timer_freeze(self, budget):
        if not TIMER_MULT.exists():
            self.saved["timer_multiplier"] = None
            return
        self.saved["timer_multiplier"] = read(TIMER_MULT)
        sysfs_write(TIMER_MULT, TIMER_FROZEN, budget)

    def psoc_timer_restore(self, budget):
        orig = self.saved.get("timer_multiplier")
        if orig is not None and TIMER_MULT.exists():
            sysfs_write(TIMER_MULT, orig, budget)

    # Wi-Fi: wait for NetworkManager's own PrepareForSleep teardown; never a
    # second radio-off (D15)
    def wifi_settle(self, budget):
        wait_until(lambda: wlan_state() in ("unavailable", "unmanaged"),
                   budget, "NetworkManager Wi-Fi teardown (unavailable|unmanaged)", 1.0)

    def wifi_unbind_l1(self, budget):
        if (CNSS_DRIVER / WIFI_BDF).exists():
            sysfs_write(CNSS_DRIVER / "unbind", WIFI_BDF, budget)
            self.saved["l1_unbound"] = True

    def wifi_rebind_l1(self, budget):
        if not self.saved.get("l1_unbound"):
            return
        if not (PCI_DEVICES / WIFI_BDF).exists():
            sysfs_write(Path("/sys/bus/pci/rescan"), "1", budget)
            wait_until(lambda: (PCI_DEVICES / WIFI_BDF).exists(), budget,
                       f"PCI device {WIFI_BDF} after rescan")
        if not (PCI_DEVICES / WIFI_BDF / "driver").exists():
            sysfs_write(CNSS_DRIVER / "bind", WIFI_BDF, budget)

    def wifi_unbind_l2(self, budget):
        if (PWRCTRL_DRIVER / PWRCTRL_DEV).exists():
            sysfs_write(PWRCTRL_DRIVER / "unbind", PWRCTRL_DEV, budget)
            self.saved["l2_unbound"] = True

    def wifi_rebind_l2(self, budget):
        if self.saved.get("l2_unbound") and not (PWRCTRL_DRIVER / PWRCTRL_DEV).exists():
            sysfs_write(PWRCTRL_DRIVER / "bind", PWRCTRL_DEV, budget)

    # evidence
    def sync(self, budget):
        os.sync()
        sysfs_write(Path("/proc/sysrq-trigger"), "s", budget)

    def journal(self, budget):
        journal_write({"event": "attempt", **dataclasses.asdict(self.a)})

    # RTC alarm: armed last, readback checked (D16: a wake candidate, not a
    # safety net; E4.5 proves its IRQ fires at all)
    def alarm_arm(self, budget):
        sysfs_write(RTC / "wakealarm", "0", budget)
        base = int(read(RTC / "since_epoch", "0"))
        sysfs_write(RTC / "wakealarm", f"+{self.a.alarm_s}", budget)
        rb = read(RTC / "wakealarm")
        if not rb.isdigit() or abs(int(rb) - (base + self.a.alarm_s)) > 3:
            raise StepFailed(f"wakealarm readback {rb!r}, expected ~{base + self.a.alarm_s}")
        self.saved["arm_ts"] = time.time()

    def alarm_clear(self, budget):
        sysfs_write(RTC / "wakealarm", "0", budget)


def journal_write(entry: dict, pmsg: Path = PMSG, mirror: Path = JOURNAL) -> None:
    """One JSON line to ramoops pmsg (survives a hard reset) and to the
    fsynced mirror (the only channel if pmsg is missing)."""
    entry = {"wall": time.time(), **entry}
    line = json.dumps(entry, sort_keys=True) + "\n"
    try:
        with pmsg.open("w") as f:
            f.write(line)
    except OSError:
        pass
    mirror.parent.mkdir(parents=True, exist_ok=True)
    with mirror.open("a") as f:
        f.write(line)
        f.flush()
        os.fsync(f.fileno())


def run_pre(attempt: Attempt, do, set_freezer, journal) -> dict:
    """Run the pre plan under the D7 guard.

    Any step that fails or overruns its budget turns the imminent sleep into
    a freezer-only pm_test run, undoes the completed steps in reverse and
    journals abort: pre-<step>. Returns the hook state for the post phase.
    """
    completed: list[Step] = []
    state: dict = {"key": list(attempt.key), "completed": [], "aborted": None,
                   "undo_errors": []}
    for step in pre_plan(attempt):
        try:
            do(step.name, step.budget_s)
        except Exception as e:  # noqa: BLE001 - every failure aborts the same way
            state["aborted"] = f"pre-{step.name}"
            state["abort_reason"] = str(e)
            set_freezer()
            for undo in undo_plan(completed):
                try:
                    do(undo, DEFAULT_BUDGET_S)
                except Exception as ue:  # noqa: BLE001
                    state["undo_errors"].append(f"{undo}: {ue}")
            journal({"event": "abort", "step": state["aborted"],
                     "reason": str(e), "key": list(attempt.key)})
            break
        completed.append(step)
        state["completed"].append(step.name)
    return state


def set_freezer() -> None:
    if (POWER / "pm_test").exists():
        sysfs_write(POWER / "pm_test", "freezer", 5)


def load_fresh_attempt() -> Attempt | None:
    try:
        a = Attempt.from_json(ATTEMPT_FILE.read_text())
    except (OSError, ValueError, LabError):
        return None
    return a if a.is_fresh(current_bootid(), time.time()) else None


def hook_pre() -> int:
    attempt = load_fresh_attempt()
    if attempt is None:
        print("erhai-lab hook pre: no fresh attempt, inert")
        return 0
    saved: dict = {"wakeups": wakeup_snapshot(),
                   "irqs": irq_counts(("pm8xxx_rtc_alarm", "pmic_pwrkey")),
                   "stats": suspend_stats(), "panel_before": panel_state()}
    actions = HookActions(attempt, saved)
    state = run_pre(attempt, actions.do, set_freezer, journal_write)
    state["saved"] = saved
    state["pre_done"] = time.time()
    HOOK_STATE.write_text(json.dumps(state, sort_keys=True))
    print(f"erhai-lab hook pre: {state['aborted'] or 'ready'} "
          f"({len(state['completed'])} steps)")
    return 0


def hook_post() -> int:
    attempt = load_fresh_attempt()
    try:
        state = json.loads(HOOK_STATE.read_text())
    except (OSError, ValueError):
        state = None
    if attempt is None or state is None or state.get("key") != list(attempt.key):
        print("erhai-lab hook post: no matching attempt, inert")
        return 0
    saved = state["saved"]
    actions = HookActions(attempt, saved)
    readouts = {
        "suspend_stats": suspend_stats(),
        "pm_wakeup_irq": read(POWER / "pm_wakeup_irq"),
        "wakeup_diff": wakeup_diff(saved["wakeups"], wakeup_snapshot()),
        "irqs_after": irq_counts(("pm8xxx_rtc_alarm", "pmic_pwrkey")),
        "qcom_stats": qcom_stats(),
        "panel_pre": panel_state(),
    }
    journal_write({"event": "resume-ok", "key": list(attempt.key)})
    root_ro = any(l.split()[1] == "/" and "ro" in l.split()[3].split(",")
                  for l in Path("/proc/mounts").read_text().splitlines())
    readouts["root_ro"] = root_ro
    errors = []
    if not state.get("aborted"):
        done = [s for s in pre_plan(attempt) if s.name in state["completed"]]
        for undo in undo_plan(done):
            try:
                actions.do(undo, DEFAULT_BUDGET_S)
            except Exception as e:  # noqa: BLE001 - restore as much as possible
                errors.append(f"{undo}: {e}")
    time.sleep(3)
    readouts["panel_post"] = panel_state()
    readouts["restore_errors"] = errors
    evdir = STATE_DIR / attempt.bootid / str(int(attempt.ts))
    evdir.mkdir(parents=True, exist_ok=True)
    (evdir / "dmesg.txt").write_text(subprocess.run(
        ["dmesg"], text=True, capture_output=True).stdout)
    (evdir / "readouts.json").write_text(json.dumps(readouts, indent=1, sort_keys=True))
    if attempt.beacon:
        journal_write({"event": "beacon-armed", "key": list(attempt.key)})
        subprocess.run(["systemd-run", "--on-active=30", "--unit=erhai-lab-beacon",
                        "--collect", "systemctl", "reboot"], check=False)
    state.update(post_done=time.time(), readouts=readouts)
    HOOK_STATE.write_text(json.dumps(state, sort_keys=True))
    print(f"erhai-lab hook post: done ({len(errors)} restore errors)")
    return 0


def cmd_hook(args: argparse.Namespace) -> int:
    require_root("hook")
    RUN_DIR.mkdir(parents=True, exist_ok=True)
    return hook_pre() if args.phase == "pre" else hook_post()


