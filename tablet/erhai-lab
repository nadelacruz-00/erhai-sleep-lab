class LabError(Exception):
    """A refusal or failure with a reason the user should see verbatim."""


# --------------------------------------------------------------- records ---

@dataclasses.dataclass
class Attempt:
    """One lab attempt, written by probe and read by the hook (D20/CQ-2)."""

    bootid: str
    ts: float
    rung: str
    wifi: str = "keep"
    display: str = "backlight"
    alarm_s: int = 0
    beacon: bool = False
    kernelrelease: str = ""
    candidate: str = ""
    build: str = ""
    pm_test: str = "none"
    mem_sleep: str = "s2idle"

    def __post_init__(self) -> None:
        if self.rung not in RUNGS:
            raise LabError(f"unknown rung {self.rung!r}")
        if self.wifi not in WIFI_LEVELS:
            raise LabError(f"unknown wifi level {self.wifi!r}")
        if self.display not in DISPLAY_MODES:
            raise LabError(f"unknown display mode {self.display!r}")
        if self.alarm_s < 0:
            raise LabError("alarm_s must be >= 0")

    @property
    def key(self) -> tuple[str, float]:
        """Idempotence key shared by the journal and the ledger."""
        return (self.bootid, self.ts)

    def to_json(self) -> str:
        return json.dumps(dataclasses.asdict(self), sort_keys=True)

    @classmethod
    def from_json(cls, text: str) -> "Attempt":
        data = json.loads(text)
        names = {f.name for f in dataclasses.fields(cls)}
        unknown = set(data) - names
        if unknown:
            raise LabError(f"attempt has unknown fields {sorted(unknown)}")
        return cls(**data)

    def is_fresh(self, bootid: str, now: float,
                 max_age: float = ATTEMPT_MAX_AGE_S) -> bool:
        """Only an attempt from this boot, written in the last max_age s."""
        return self.bootid == bootid and 0 <= now - self.ts <= max_age


def current_bootid() -> str:
    return Path("/proc/sys/kernel/random/boot_id").read_text().strip()


def lab_identity(cmdline: str) -> tuple[str, str]:
    """(candidate, build) from erhai_lab.* params on a lab UKI's cmdline."""
    cand = build = ""
    for word in cmdline.split():
        if word.startswith("erhai_lab.candidate="):
            cand = word.split("=", 1)[1]
        elif word.startswith("erhai_lab.build="):
            build = word.split("=", 1)[1]
    return cand, build


# ----------------------------------------------------------------- fetch ---

def parse_sums(text: str) -> dict[str, str]:
    """sha256sum output -> {filename: hexdigest}."""
    sums: dict[str, str] = {}
    for n, line in enumerate(text.splitlines(), 1):
        if not line.strip():
            continue
        m = re.fullmatch(r"([0-9a-f]{64}) [ *](.+)", line.strip())
        if not m:
            raise LabError(f"SHA256SUMS line {n} is malformed: {line!r}")
        sums[m.group(2)] = m.group(1)
    if not sums:
        raise LabError("SHA256SUMS is empty")
    return sums


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def verify_assets(directory: Path) -> None:
    """Every downloaded file must be listed in SHA256SUMS and match it (D6)."""
    sums_path = directory / "SHA256SUMS"
    if not sums_path.is_file():
        raise LabError("release has no SHA256SUMS; refusing to install")
    sums = parse_sums(sums_path.read_text())
    present = {p.name for p in directory.iterdir() if p.is_file()} - {"SHA256SUMS"}
    missing = sorted(set(sums) - present)
    if missing:
        raise LabError(f"listed in SHA256SUMS but not downloaded: {missing}")
    unlisted = sorted(present - set(sums))
    if unlisted:
        raise LabError(f"downloaded but not listed in SHA256SUMS: {unlisted}")
    for name, want in sorted(sums.items()):
        got = sha256_file(directory / name)
        if got != want:
            raise LabError(f"checksum mismatch for {name}: {got} != {want}")


@dataclasses.dataclass
class Assets:
    kver: str
    uki: Path
    modules: Path
    config: Path


def identify_assets(directory: Path, candidate: str) -> Assets:
    """One UKI, one modules tarball, one config, all for the same lab kver."""
    names = sorted(p.name for p in directory.iterdir() if p.is_file())
    ukis = [n for n in names if n.endswith(".efi")]
    mods = [n for n in names if n.startswith("modules-") and n.endswith(".tar.zst")]
    cfgs = [n for n in names if n.startswith("config-")]
    if len(ukis) != 1 or len(mods) != 1 or len(cfgs) != 1:
        raise LabError(f"expected one .efi, one modules tarball and one config, got {names}")
    kver = ukis[0][: -len(".efi")]
    if mods[0] != f"modules-{kver}.tar.zst" or cfgs[0] != f"config-{kver}":
        raise LabError(f"UKI {ukis[0]} does not match {mods[0]} / {cfgs[0]}")
    if not kver.endswith(f"-lab-{candidate}"):
        raise LabError(f"kernelrelease {kver} is not a lab build of {candidate}")
    return Assets(kver, directory / ukis[0], directory / mods[0], directory / cfgs[0])


def latest_tag(tags: list[str], candidate: str) -> str:
    """Highest lab-<candidate>-<run> tag."""
    prefix = f"lab-{candidate}-"
    runs = []
    for t in tags:
        if t.startswith(prefix) and t[len(prefix):].isdigit():
            runs.append(int(t[len(prefix):]))
    if not runs:
        raise LabError(f"no release found for candidate {candidate}")
    return f"{prefix}{max(runs)}"


API = "https://api.github.com"


def http_get(url: str, accept: str = "application/vnd.github+json") -> bytes:
    """Anonymous HTTPS GET: the lab repo is public, and fetch runs as root,
    which has no gh login."""
    import urllib.error
    import urllib.request
    req = urllib.request.Request(url, headers={"Accept": accept,
                                               "User-Agent": "erhai-lab"})
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            return r.read()
    except urllib.error.HTTPError as e:
        raise LabError(f"GET {url}: HTTP {e.code} {e.reason}") from None
    except urllib.error.URLError as e:
        raise LabError(f"GET {url}: {e.reason}") from None


def release_assets(releases: list[dict], tag: str) -> list[tuple[str, str]]:
    """(name, download url) of every asset of the release tagged `tag`."""
    for r in releases:
        if r.get("tag_name") == tag:
            return [(a["name"], a["browser_download_url"]) for a in r.get("assets", [])]
    raise LabError(f"release {tag} not found")


def install_assets(assets: Assets, boot_dir: Path = BOOT_DIR,
                   modules_dir: Path = MODULES_DIR) -> None:
    """Copy a verified lab kernel beside the package kernel.

    Only ever writes /boot/<lab kver>.efi and /usr/lib/modules/<lab kver>/;
    the package's UKI, its modules and rEFInd's default are never touched.
    """
    if "-lab-" not in assets.kver:
        raise LabError(f"refusing to install non-lab kernelrelease {assets.kver}")
    target = modules_dir / assets.kver
    staging = Path(tempfile.mkdtemp(prefix=".erhai-lab-", dir=modules_dir))
    try:
        subprocess.run(["tar", "--zstd", "-x", "-f", str(assets.modules),
                        "-C", str(staging)], check=True)
        unpacked = staging / assets.kver
        if not unpacked.is_dir():
            raise LabError(f"modules tarball has no {assets.kver}/ directory")
        if target.exists():
            shutil.rmtree(target)
        unpacked.rename(target)
    finally:
        shutil.rmtree(staging, ignore_errors=True)
    tmp_uki = boot_dir / f".{assets.kver}.efi.tmp"
    shutil.copyfile(assets.uki, tmp_uki)
    os.replace(tmp_uki, boot_dir / f"{assets.kver}.efi")
    subprocess.run(["depmod", "-a", assets.kver], check=True)


def cmd_fetch(args: argparse.Namespace) -> int:
    releases = json.loads(http_get(f"{API}/repos/{args.repo}/releases?per_page=100"))
    tag = args.tag or latest_tag([r["tag_name"] for r in releases], args.candidate)
    assets_list = release_assets(releases, tag)
    with tempfile.TemporaryDirectory(prefix="erhai-lab-fetch-") as tmp:
        d = Path(tmp)
        for name, url in assets_list:
            if "/" in name or name.startswith("."):
                raise LabError(f"refusing asset name {name!r}")
            print(f"  downloading {name}")
            (d / name).write_bytes(http_get(url, "application/octet-stream"))
        verify_assets(d)
        assets = identify_assets(d, args.candidate)
        print(f"{tag}: verified {assets.kver} ({len(parse_sums((d / 'SHA256SUMS').read_text()))} files)")
        if args.verify_only:
            return 0
        require_root("fetch")
        install_assets(assets)
    print(f"installed /boot/{assets.kver}.efi and {MODULES_DIR / assets.kver}/")
    print("Pick it in the rEFInd menu on the next boot; the default entry is unchanged.")
    return 0


# ------------------------------------------------------------ arm/disarm ---

DROPIN_TEXT = """\
# Written by erhai-lab arm for one lab attempt and removed by erhai-lab disarm
# (eng review D19). It runs systemd-sleep, so the system-sleep hooks run, and
# keeps user sessions unfrozen so the hook can use the session bus (D14).
[Service]
ExecStart=
ExecStart=/usr/lib/systemd/systemd-sleep suspend
Environment=SYSTEMD_SLEEP_FREEZE_USER_SESSIONS=false
"""


def arm(dropin_dir: Path = DROPIN_DIR, reload: bool = True) -> Path:
    dropin_dir.mkdir(parents=True, exist_ok=True)
    path = dropin_dir / DROPIN_NAME
    tmp = path.with_suffix(".tmp")
    tmp.write_text(DROPIN_TEXT)
    os.replace(tmp, path)
    if reload:
        subprocess.run(["systemctl", "daemon-reload"], check=True)
    return path


def disarm(dropin_dir: Path = DROPIN_DIR, reload: bool = True) -> bool:
    """Remove the lab drop-in; True if one was present. Idempotent."""
    path = dropin_dir / DROPIN_NAME
    present = path.exists()
    if present:
        path.unlink()
    if reload:
        subprocess.run(["systemctl", "daemon-reload"], check=True)
    return present


def suspend_execstart() -> str:
    out = subprocess.run(["systemctl", "show", "-p", "ExecStart",
                          "systemd-suspend.service"], check=True, text=True,
                         capture_output=True).stdout
    m = re.search(r"path=(\S+)", out)
    return m.group(1) if m else out.strip()


def cmd_arm(args: argparse.Namespace) -> int:
    require_root("arm")
    path = arm()
    print(f"armed: {path}; systemd-suspend ExecStart = {suspend_execstart()}")
    return 0


def cmd_disarm(args: argparse.Namespace) -> int:
    require_root("disarm")
    present = disarm()
    print(("disarmed" if present else "was not armed")
          + f"; systemd-suspend ExecStart = {suspend_execstart()}")
    return 0


# ------------------------------------------------------------- hook plan ---

@dataclasses.dataclass(frozen=True)
class Step:
    name: str
    budget_s: float
    undo: str | None = None


DEFAULT_BUDGET_S = 15.0
WIFI_SETTLE_S = 12.0   # the dev harness's STEP2c window
GPU_PARK_S = 15.0


def pre_plan(attempt: Attempt | None) -> list[Step]:
    """Ordered pre-sleep steps for an attempt (D7, D13, D15, D16).

    No fresh attempt -> no steps: the hook is inert outside an armed attempt.
    The hook never issues a Wi-Fi radio-off; NetworkManager does its own on
    PrepareForSleep and a second one raced it (D15). The RTC alarm is armed
    last so it cannot fire before the kernel is asleep.
    """
    if attempt is None:
        return []
    steps: list[Step] = []
    if attempt.display == "park":
        steps.append(Step("display-park", GPU_PARK_S, "display-unpark"))
    else:
        steps.append(Step("display-off", DEFAULT_BUDGET_S, "display-on"))
    steps.append(Step("watcher-stop", DEFAULT_BUDGET_S, "watcher-start"))
    steps.append(Step("psoc-timer-freeze", DEFAULT_BUDGET_S, "psoc-timer-restore"))
    if attempt.wifi != "keep":
        steps.append(Step("wifi-settle", WIFI_SETTLE_S, None))
        steps.append(Step("wifi-unbind-l1", DEFAULT_BUDGET_S, "wifi-rebind-l1"))
        if attempt.wifi == "L2":
            steps.append(Step("wifi-unbind-l2", DEFAULT_BUDGET_S, "wifi-rebind-l2"))
    steps.append(Step("sync", DEFAULT_BUDGET_S, None))
    steps.append(Step("journal", DEFAULT_BUDGET_S, None))
    if attempt.alarm_s > 0:
        steps.append(Step("alarm-arm", DEFAULT_BUDGET_S, "alarm-clear"))
    return steps


def undo_plan(completed: list[Step]) -> list[str]:
    """Undo actions for completed pre steps, in reverse order (D7)."""
    return [s.undo for s in reversed(completed) if s.undo]


def post_plan(attempt: Attempt | None) -> list[str]:
    """Ordered post-resume actions: readouts first, then the undo of pre."""
    if attempt is None:
        return []
    actions = ["readouts", "resume-ok", "mount-check"]
    actions += undo_plan(pre_plan(attempt))
    actions.append("panel-readout")
    if attempt.beacon:
        actions.append("beacon")
    return actions


def cmd_plan(args: argparse.Namespace) -> int:
    attempt = Attempt(bootid="plan", ts=0.0, rung=args.rung, wifi=args.wifi,
                      display=args.display, alarm_s=args.alarm,
                      beacon=args.beacon)
    print("pre:")
    for s in pre_plan(attempt):
        print(f"  {s.name:<20} budget {s.budget_s:>4.0f} s   undo: {s.undo or '-'}")
    print("post:")
    for a in post_plan(attempt):
        print(f"  {a}")
    return 0


