DISPLAY_TOGGLE = "/usr/local/sbin/erhai-display-toggle.sh"
WATCHER_UNIT = "erhai-power-toggle.service"
TIMER_MULT = Path("/sys/module/wlan/parameters/timer_multiplier")
TIMER_FROZEN = "1000000"
WIFI_BDF = "0000:01:00.0"
PCI_DEVICES = Path("/sys/bus/pci/devices")
CNSS_DRIVER = Path("/sys/bus/pci/drivers/cnss_pci")
PWRCTRL_DEV = "1c00000.pcie:pcie@0:wifi@0"
PWRCTRL_DRIVER = Path("/sys/bus/platform/drivers/pci-pwrctrl-pwrseq")
