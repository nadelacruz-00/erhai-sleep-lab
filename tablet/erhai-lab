class FailingActions(HookActions):
    """Real actions, except one step that fails on purpose (guard test)."""

    def __init__(self, attempt, saved, fail_at):
        super().__init__(attempt, saved)
        self.fail_at = fail_at

    def do(self, name, budget):
        if name == self.fail_at:
            raise StepFailed(f"injected failure at {name}")
        super().do(name, budget)


def cmd_dryrun(args: argparse.Namespace) -> int:
    """Step-2 dry run: the real hook pre/post on this kernel, no sleep.

    Exercises the display, watcher, timer and Wi-Fi steps and their undo with
    the session live, exactly as an armed attempt would, but never writes
    /sys/power/state. --fail-at injects a failure to prove the D7 guard.
    """
    require_root("dryrun")
    check_wifi_level(args.wifi, args.i_know_wifi_removal_oopses)
    if args.fail_at and args.fail_at not in {s.name for s in pre_plan(
            Attempt(bootid="x", ts=0, rung="dry", wifi=args.wifi,
                    display=args.display, alarm_s=args.alarm))}:
        raise LabError(f"--fail-at {args.fail_at} is not a step of this plan")
    RUN_DIR.mkdir(parents=True, exist_ok=True)
    attempt = Attempt(bootid=current_bootid(), ts=time.time(), rung="dry",
                      wifi=args.wifi, display=args.display, alarm_s=args.alarm,
                      kernelrelease=os.uname().release)
    # A pwrctrl rebind runs the WCN cold bring-up, which the dev has seen
    # reset the SoC: make sure a reset here is attributable and the root is
    # synced first (office-hours R3-6).
    os.sync()
    sysfs_write(Path("/proc/sysrq-trigger"), "s", 10)
    journal_write({"event": "dryrun-start", **dataclasses.asdict(attempt)})
    ATTEMPT_FILE.write_text(attempt.to_json())
    HOOK_STATE.unlink(missing_ok=True)
    dmesg_mark = f"erhai-lab dryrun {int(attempt.ts)}"
    sysfs_write(Path("/dev/kmsg"), dmesg_mark, 5)

    saved: dict = {"wakeups": wakeup_snapshot(), "irqs": {}, "stats": {},
                   "panel_before": panel_state()}
    actions = (FailingActions(attempt, saved, args.fail_at) if args.fail_at
               else HookActions(attempt, saved))
    noop_freezer = lambda: print("  (guard: would set pm_test=freezer)")  # noqa: E731
    hold = args.hold
    if args.wifi != "keep":
        # No PrepareForSleep in a dry run, so NetworkManager is not touching
        # the chip: one radio-off here stands in for its teardown (the dev
        # harness's standalone QUIESCE=1 path). Never in a real attempt (D15).
        # Off->on within seconds wedged the WCN in the dev's DRY runs, so
        # stay down at least 30 s.
        hold = max(hold, 30)
        run(["nmcli", "radio", "wifi", "off"], 15)
    state = run_pre(attempt, actions.do, noop_freezer, journal_write)
    print(f"pre: completed {state['completed']}")
    if state["aborted"]:
        print(f"pre: ABORTED at {state['aborted']}: {state.get('abort_reason')}")
        print(f"pre: undo errors: {state['undo_errors'] or 'none'}")
    print(f"pre: wlan={wlan_state()} panel={panel_state()} "
          f"gpu={read(GPU_POWER / 'runtime_status')}")
    if not state["aborted"]:
        print(f"holding {hold} s with everything torn down ...")
        time.sleep(hold)
        state["saved"] = saved
        state["pre_done"] = time.time()
        HOOK_STATE.write_text(json.dumps(state, sort_keys=True))
        hook_post()
        post = json.loads(HOOK_STATE.read_text())
        print(f"post: restore errors {post['readouts']['restore_errors'] or 'none'}")
        print(f"post: panel {post['readouts']['panel_post']}")
    ATTEMPT_FILE.unlink(missing_ok=True)
    if args.wifi != "keep":
        if state["aborted"]:
            time.sleep(max(0, 30 - (time.time() - attempt.ts)))
        run(["nmcli", "radio", "wifi", "on"], 15)
        if not args.no_wait_wifi:
            wait_until(lambda: wlan_state() == "connected", 90, "Wi-Fi reconnect", 2.0)
            print("Wi-Fi reconnected")
    kmsg = subprocess.run(["dmesg"], text=True, capture_output=True).stdout
    tail = kmsg[kmsg.rfind(dmesg_mark):] if dmesg_mark in kmsg else ""
    sig = [l for l in tail.splitlines()
           if re.search(r"erhai-cc|pwrseq|WLAN_EN|SError|NoC|cnss: .*(power|link)", l)]
    print(f"dmesg signature since start ({len(sig)} lines):")
    for l in sig[-40:]:
        print("  " + l)
    journal_write({"event": "dryrun-end", "key": list(attempt.key),
                   "aborted": state["aborted"]})
    return 0


# ------------------------------------------------------------ wifi-cycle ---

def cmd_wifi_cycle(args: argparse.Namespace) -> int:
    """Sleep-free reproducer for the WLAN idle-shutdown oops (D25).

    Each cycle turns the radio off (NetworkManager takes wlp1s0 down and the
    WLAN idle shutdown follows after gInterfaceChangeWait), waits, turns it
    back on (idle restart) and waits for a connection. On the stock kernel the
    third idle shutdown after boot oopsed in hif_exec_napi_kill. Runs as a
    transient system unit: Wi-Fi, and any session using it, drops during
    the off phases. Results go to the lab journal and the unit's log.
    """
    require_root("wifi-cycle")
    if os.environ.get("ERHAI_LAB_IN_UNIT") != "1":
        tool = os.path.realpath(sys.argv[0])
        r = subprocess.run(["systemd-run", "--unit=erhai-lab-wifi-cycle", "--collect",
                            "--setenv=ERHAI_LAB_IN_UNIT=1", tool, "wifi-cycle",
                            "--count", str(args.count), "--off", str(args.off)])
        if r.returncode == 0:
            print("started; Wi-Fi will drop. Afterwards: "
                  "journalctl -u erhai-lab-wifi-cycle -o cat")
        return r.returncode
    base = f"erhai-lab wifi-cycle {int(time.time())}"
    sysfs_write(Path("/dev/kmsg"), base, 5)
    journal_write({"event": "wifi-cycle-start", "count": args.count,
                   "kernelrelease": os.uname().release,
                   "gInterfaceChangeWait": wlan_ini_value("gInterfaceChangeWait")})
    for i in range(1, args.count + 1):
        mark = f"{base} cycle {i}"
        sysfs_write(Path("/dev/kmsg"), mark, 5)
        os.sync()
        run(["nmcli", "radio", "wifi", "off"], 15)
        time.sleep(args.off)
        run(["nmcli", "radio", "wifi", "on"], 15)
        try:
            wait_until(lambda: wlan_state() == "connected", 90, "Wi-Fi reconnect", 2.0)
            connected = True
        except StepFailed:
            connected = False
        kmsg = subprocess.run(["dmesg"], text=True, capture_output=True).stdout
        ev = wlan_events_since(kmsg, mark)
        line = (f"cycle {i}: idle shutdowns {ev['idle_shutdown']}, idle restarts "
                f"{ev['idle_restart']}, oopses {ev['oops']}, reconnected {connected}")
        print(line, flush=True)
        journal_write({"event": "wifi-cycle", "cycle": i, "wlan": ev, "connected": connected})
        if ev["oops"] or not connected:
            print("stopping: oops or no reconnect", flush=True)
            return 1
    return 0


# ----------------------------------------------------------------- check ---

def e0_checks() -> list[tuple[str, bool, str]]:
    """Readiness for the ladder on the running kernel (E0, step 2)."""
    res: list[tuple[str, bool, str]] = []
    cand, build = lab_identity(read(Path("/proc/cmdline")))
    res.append(("lab kernel", bool(cand), f"{os.uname().release} candidate={cand or '-'} build={build or '-'}"))
    res.append(("pm_test", (POWER / "pm_test").exists(), read(POWER / "pm_test", "absent")))
    res.append(("pm_debug_messages", (POWER / "pm_debug_messages").exists(),
                read(POWER / "pm_debug_messages", "absent")))
    try:
        cfg = subprocess.run(["sh", "-c", "zcat /proc/config.gz"], text=True,
                             capture_output=True, timeout=10).stdout
    except subprocess.TimeoutExpired:
        cfg = ""
    wd = "CONFIG_DPM_WATCHDOG=y" in cfg.splitlines()
    res.append(("DPM watchdog", wd, "CONFIG_DPM_WATCHDOG=y" if wd else "not in /proc/config.gz"))
    res.append(("mem_sleep s2idle", "[s2idle]" in read(POWER / "mem_sleep"), read(POWER / "mem_sleep")))
    res.append(("pmsg", PMSG.exists(), str(PMSG)))
    res.append(("rtc0 alarm", (RTC / "wakealarm").exists(),
                f"{read(RTC / 'name')} since_epoch={read(RTC / 'since_epoch')}"))
    res.append(("pwrkey wake source", any("pwrkey" in read(w / "name") for w in
                                          Path("/sys/class/wakeup").glob("wakeup*")), ""))
    res.append(("persistent journald", Path("/var/log/journal").is_dir(), "/var/log/journal"))
    res.append(("qcom_stats", QCOM_STATS.is_dir(), str(QCOM_STATS)))
    res.append(("GPU runtime PM", (GPU_POWER / "runtime_status").exists(),
                f"{read(GPU_POWER / 'control')}/{read(GPU_POWER / 'runtime_status')}"))
    res.append(("cnss_pci bound", (CNSS_DRIVER / WIFI_BDF).exists(), WIFI_BDF))
    res.append(("pwrctrl bound", (PWRCTRL_DRIVER / PWRCTRL_DEV).exists(), PWRCTRL_DEV))
    res.append(("session for SetActive", session_user() is not None, str(session_user())))
    pkg = subprocess.run(["dpkg-query", "-W", "-f", "${Version}", "oneplus-erhai-linux-7.3"],
                         text=True, capture_output=True).stdout.strip()
    rev = pkg.rsplit("+b", 1)[-1] if "+b" in pkg else ""
    ukis = sorted(p.name for p in BOOT_DIR.glob("*.efi"))
    revert = next((u for u in ukis if u.endswith(f"-b{rev}.efi")), "")
    res.append(("revert UKI = package's", bool(revert), f"package {pkg} -> {revert or '?'}; all: {ukis}"))
    held = "oneplus-erhai-linux-7.3" in subprocess.run(
        ["apt-mark", "showhold"], text=True, capture_output=True).stdout
    res.append(("kernel package held (D17)", held, "apt-mark hold oneplus-erhai-linux-7.3"))
    res.append(("lab override not armed", not (DROPIN_DIR / DROPIN_NAME).exists(),
                str(DROPIN_DIR / DROPIN_NAME)))
    return res


def cmd_check(args: argparse.Namespace) -> int:
    ok_all = True
    for name, ok, detail in e0_checks():
        ok_all &= ok
        print(f"[{'ok' if ok else '--'}] {name:<26} {detail}")
    return 0 if ok_all else 1


# ---------------------------------------------------------------- ladder ---

def e5_level(e4_kept_passed: bool,
             e4u: dict[str, bool]) -> tuple[str, bool] | None:
    """Wi-Fi level for E5 and whether it needs its own platform gate (D21).

    E5 always runs with Wi-Fi removed, at the least-removal level that passed
    the platform rung. When E4 passed with Wi-Fi kept, that is L1, which E4
    never ran, so one pm_test=platform pass at L1 gates E5.
    """
    if e4_kept_passed:
        return ("L1", True)
    for level in ("L1", "L2"):
        if e4u.get(level):
            return (level, False)
    return None


# ------------------------------------------------------------------ main ---

def require_root(what: str) -> None:
    if os.geteuid() != 0:
        raise LabError(f"{what} needs root; run it with sudo")


def cmd_not_yet(args: argparse.Namespace) -> int:
    raise LabError(f"'{args.cmd}' is not implemented in this build yet")


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="erhai-lab", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    f = sub.add_parser("fetch", help="download, verify and install a lab kernel")
    f.add_argument("candidate")
    f.add_argument("--tag", help="exact release tag (default: latest for the candidate)")
    f.add_argument("--repo", default=REPO)
    f.add_argument("--verify-only", action="store_true",
                   help="download and verify, install nothing")
    f.set_defaults(func=cmd_fetch)

    sub.add_parser("arm", help="install the one-attempt suspend override").set_defaults(func=cmd_arm)
    sub.add_parser("disarm", help="remove the suspend override").set_defaults(func=cmd_disarm)

    pl = sub.add_parser("plan", help="print the hook step plan for an attempt")
    pl.add_argument("--rung", default="E2", choices=RUNGS)
    pl.add_argument("--wifi", default="keep", choices=WIFI_LEVELS)
    pl.add_argument("--display", default="backlight", choices=DISPLAY_MODES)
    pl.add_argument("--alarm", type=int, default=0)
    pl.add_argument("--beacon", action="store_true")
    pl.set_defaults(func=cmd_plan)

    h = sub.add_parser("hook", help="systemd-sleep hook (called by the system-sleep caller)")
    h.add_argument("phase", choices=("pre", "post"))
    h.add_argument("action", nargs="?", default="suspend")
    h.set_defaults(func=cmd_hook)

    pr = sub.add_parser("probe", help="run one lab attempt (pm_test rungs E1-E4.5)")
    pr.add_argument("--rung", required=True, choices=RUNGS)
    pr.add_argument("--wifi", default="keep", choices=WIFI_LEVELS)
    pr.add_argument("--display", default="backlight", choices=DISPLAY_MODES)
    pr.add_argument("--alarm", type=int, default=0, help="RTC alarm seconds (0 = none)")
    pr.add_argument("--beacon", action="store_true")
    pr.add_argument("--i-know-wifi-removal-oopses", action="store_true",
                    help=argparse.SUPPRESS)
    pr.set_defaults(func=cmd_probe)

    dr = sub.add_parser("dryrun", help="real hook pre/post on this kernel, no sleep (step 2)")
    dr.add_argument("--wifi", default="keep", choices=WIFI_LEVELS)
    dr.add_argument("--display", default="backlight", choices=DISPLAY_MODES)
    dr.add_argument("--alarm", type=int, default=0)
    dr.add_argument("--hold", type=int, default=10, help="seconds to stay torn down")
    dr.add_argument("--fail-at", help="inject a failure at this pre step (guard test)")
    dr.add_argument("--no-wait-wifi", action="store_true")
    dr.add_argument("--i-know-wifi-removal-oopses", action="store_true",
                    help=argparse.SUPPRESS)
    dr.set_defaults(func=cmd_dryrun)

    sub.add_parser("check", help="E0 readiness checklist for the running kernel").set_defaults(func=cmd_check)

    wc = sub.add_parser("wifi-cycle", help="sleep-free WLAN idle shutdown/restart reproducer")
    wc.add_argument("--count", type=int, default=5)
    wc.add_argument("--off", type=int, default=20, help="seconds the radio stays off")
    wc.set_defaults(func=cmd_wifi_cycle)

    for name in ("boot", "ack"):
        q = sub.add_parser(name, help="(wave 1b, not in this build yet)")
        q.add_argument("rest", nargs="*")
        q.set_defaults(func=cmd_not_yet)
    return p


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        return args.func(args)
    except LabError as e:
        print(f"erhai-lab: {e}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
