PM_TEST = {"E1": "freezer", "E2": "devices", "E3": "devices", "E4": "platform",
           "E4.5": "platform", "E5": "none", "E6": "none", "E7": "none"}


WIFI_REMOVAL_SUSPENDED = (
    "Wi-Fi removal (L1/L2) is suspended: unbinding cnss_pci with wlan.ko "
    "loaded oopsed in hif_exec_napi_kill on 2026-10-21 (docs/ladder.md); "
    "pass --i-know-wifi-removal-oopses to run it anyway")


def check_wifi_level(wifi: str, override: bool) -> None:
    if wifi != "keep" and not override:
        raise LabError(WIFI_REMOVAL_SUSPENDED)


def check_probe_request(rung: str, alarm_s: int, has_pm_test: bool,
                        candidate: str) -> None:
    """Refusals that keep the ladder safe (D16, D21, office-hours R3-5)."""
    if rung == "dry":
        raise LabError("use `erhai-lab dryrun` for the no-sleep dry run")
    if rung == "E0":
        raise LabError("E0 is a manual rung (see docs/ladder.md), not a probe run")
    if not candidate:
        raise LabError("not running a lab kernel (no erhai_lab.candidate on the cmdline)")
    if not has_pm_test:
        raise LabError("this kernel has no /sys/power/pm_test; boot a PM-debug lab kernel")
    if rung in REAL_SLEEP_RUNGS:
        raise LabError(f"{rung} is a real-sleep rung; it needs the wave 1b "
                       "classifier and ack (not in this build)")
    if rung == "E4.5" and alarm_s <= 0:
        raise LabError("E4.5 proves the RTC alarm IRQ; give --alarm")


PM_TEST_DELAY = Path("/sys/module/suspend/parameters/pm_test_delay")


def pm_test_hold(pm_test: str, alarm_s: int) -> int | None:
    """Seconds pm_test must hold the suspended state so an armed alarm can
    fire inside it; None when nothing needs changing."""
    if pm_test == "none" or alarm_s <= 0:
        return None
    return alarm_s + 10


def pm_test_verdict(rung: str, before: dict, after: dict, aborted: str | None,
                    irq_before: dict, irq_after: dict) -> str:
    if aborted:
        return f"abort ({aborted})"
    try:
        ds = int(after.get("success", 0)) - int(before.get("success", 0))
        df = int(after.get("fail", 0)) - int(before.get("fail", 0))
    except ValueError:
        return "unknown (suspend_stats unreadable)"
    if df or ds != 1:
        return (f"fail (success +{ds}, fail +{df}, step "
                f"{after.get('last_failed_step', '?')}, dev {after.get('last_failed_dev', '?')})")
    # A device that fails to *resume* bumps failed_resume* but not fail, and
    # the cycle still counts as a success: a pass must not hide it.
    resume_fail = {k: int(after.get(k, 0)) - int(before.get(k, 0))
                   for k in ("failed_resume", "failed_resume_early", "failed_resume_noirq")
                   if str(after.get(k, "0")).isdigit() and str(before.get(k, "0")).isdigit()}
    bad = {k: v for k, v in resume_fail.items() if v}
    if bad:
        return (f"fail (resume errors {bad}, last dev "
                f"{after.get('last_failed_dev', '?')})")
    if rung == "E4.5":
        a = irq_after.get("pm8xxx_rtc_alarm", 0) - irq_before.get("pm8xxx_rtc_alarm", 0)
        return "pass" if a > 0 else "fail (RTC alarm IRQ did not fire)"
    return "pass"


WLAN_INI = Path("/usr/lib/firmware/wlan/qca_cld/WCNSS_qcom_cfg.ini")


def wlan_ini_value(key: str, ini: Path = WLAN_INI) -> str | None:
    """Value of a qcacld INI key, or None when unset (driver default).

    gInterfaceChangeWait is the WLAN idle-shutdown delay; 0 disables the idle
    shutdown that crashed in hif_exec_napi_kill (D24). Scaling the qdf timers
    (timer_multiplier) does not change it: hdd_psoc_idle_timer_start() passes
    the INI value straight to qdf_delayed_work_start().
    """
    try:
        lines = ini.read_text().splitlines()
    except OSError:
        return None
    for line in lines:
        k, sep, v = line.strip().partition("=")
        if sep and k.strip() == key:
            return v.strip()
    return None


def wlan_events_since(kmsg: str, marker: str) -> dict[str, int]:
    """Count WLAN idle shutdowns/restarts and oopses after the probe marker."""
    i = kmsg.rfind(marker)
    tail = kmsg[i:] if i >= 0 else ""
    return {"idle_shutdown": tail.count("cnss: Doing idle shutdown"),
            "idle_restart": tail.count("cnss: Doing idle restart"),
            "oops": len(re.findall(r"Internal error: Oops", tail))}


def cmd_probe(args: argparse.Namespace) -> int:
    require_root("probe")
    if os.environ.get("ERHAI_LAB_IN_UNIT") != "1":
        # Run outside the user's session scope so a session freeze or
        # teardown cannot stop the probe mid-attempt (D20).
        tool = os.path.realpath(sys.argv[0])
        cmd = ["systemd-run", "--unit=erhai-lab-probe", "--collect", "--pipe",
               "--wait", "--quiet", "--setenv=ERHAI_LAB_IN_UNIT=1", tool,
               "probe", "--rung", args.rung, "--wifi", args.wifi,
               "--display", args.display, "--alarm", str(args.alarm)]
        if args.beacon:
            cmd.append("--beacon")
        if args.i_know_wifi_removal_oopses:
            cmd.append("--i-know-wifi-removal-oopses")
        return subprocess.run(cmd).returncode

    cand, build = lab_identity(read(Path("/proc/cmdline")))
    check_wifi_level(args.wifi, args.i_know_wifi_removal_oopses)
    check_probe_request(args.rung, args.alarm, (POWER / "pm_test").exists(), cand)
    RUN_DIR.mkdir(parents=True, exist_ok=True)
    import fcntl
    lock = (RUN_DIR / "lock").open("w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        raise LabError("another erhai-lab attempt is running") from None

    attempt = Attempt(bootid=current_bootid(), ts=time.time(), rung=args.rung,
                      wifi=args.wifi, display=args.display, alarm_s=args.alarm,
                      beacon=args.beacon, kernelrelease=os.uname().release,
                      candidate=cand, build=build, pm_test=PM_TEST[args.rung],
                      mem_sleep="s2idle")
    HOOK_STATE.unlink(missing_ok=True)
    ATTEMPT_FILE.write_text(attempt.to_json())
    before = suspend_stats()
    irq_before = irq_counts(("pm8xxx_rtc_alarm", "pmic_pwrkey"))
    print(f"{attempt.rung}: pm_test={attempt.pm_test} wifi={attempt.wifi} "
          f"display={attempt.display} alarm={attempt.alarm_s}s "
          f"gInterfaceChangeWait={wlan_ini_value('gInterfaceChangeWait') or 'default (250)'} "
          f"on {attempt.kernelrelease}")
    marker = f"erhai-lab probe {int(attempt.ts)}"
    sysfs_write(Path("/dev/kmsg"), marker, 5)
    print_times = read(POWER / "pm_print_times", "")
    # pm_test holds the suspended state for pm_test_delay seconds (default
    # 5). An alarm armed for longer would be cleared by the post hook before
    # it could fire, so stretch the hold past the alarm.
    delay_orig = read(PM_TEST_DELAY) if PM_TEST_DELAY.exists() else ""
    hold = pm_test_hold(attempt.pm_test, attempt.alarm_s)
    try:
        if hold and delay_orig:
            sysfs_write(PM_TEST_DELAY, str(hold), 5)
        if "[s2idle]" not in read(POWER / "mem_sleep"):
            sysfs_write(POWER / "mem_sleep", "s2idle", 5)
        if print_times:
            sysfs_write(POWER / "pm_print_times", "1", 5)
        sysfs_write(POWER / "pm_test", attempt.pm_test, 5)
        arm()
        subprocess.run(["systemctl", "suspend"], check=True)
        wait_until(lambda: HOOK_STATE.exists() and "post_done" in read(HOOK_STATE),
                   attempt.alarm_s + (hold or 0) + 120, "post hook completion", 1.0)
        state = json.loads(HOOK_STATE.read_text())
    finally:
        disarm()
        if (POWER / "pm_test").exists():
            sysfs_write(POWER / "pm_test", "none", 5)
        if print_times:
            sysfs_write(POWER / "pm_print_times", print_times, 5)
        if hold and delay_orig:
            sysfs_write(PM_TEST_DELAY, delay_orig, 5)
        ATTEMPT_FILE.unlink(missing_ok=True)
    ro = state.get("readouts", {})
    verdict = pm_test_verdict(attempt.rung, before, ro.get("suspend_stats", {}),
                              state.get("aborted"), irq_before, ro.get("irqs_after", {}))
    kmsg = subprocess.run(["dmesg"], text=True, capture_output=True).stdout
    wlan = wlan_events_since(kmsg, marker)
    journal_write({"event": "result", "ok": True, "key": list(attempt.key),
                   "verdict": verdict, "wlan": wlan,
                   "gInterfaceChangeWait": wlan_ini_value("gInterfaceChangeWait")})
    print(f"verdict: {verdict}")
    print(f"wlan: idle shutdowns {wlan['idle_shutdown']}, idle restarts "
          f"{wlan['idle_restart']}, oopses {wlan['oops']}")
    if attempt.alarm_s > 0:
        # Reported on its own: a resume error elsewhere decides the verdict
        # first and would hide whether the alarm fired.
        fired = (ro.get("irqs_after", {}).get("pm8xxx_rtc_alarm", 0)
                 - irq_before.get("pm8xxx_rtc_alarm", 0))
        print(f"rtc alarm irq: +{fired} ({'fired' if fired > 0 else 'did NOT fire'}); "
              f"held {hold or read(PM_TEST_DELAY, '?')} s")
    if state.get("abort_reason"):
        print(f"abort reason: {state['abort_reason']}")
    for k in ("pm_wakeup_irq", "wakeup_diff", "panel_post", "root_ro", "restore_errors"):
        print(f"{k}: {ro.get(k)}")
    print(f"evidence: {STATE_DIR / attempt.bootid / str(int(attempt.ts))}/")
    return 0 if verdict == "pass" else 1


